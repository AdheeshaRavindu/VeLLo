# ElevenLabs API key from your ElevenLabs dashboard:
# https://elevenlabs.io/app/speech-synthesis
# Leave blank to use browser speech fallback from frontend.
ELEVENLABS_API_KEY=

# Optional ElevenLabs voice ID.
# Default dev value used by backend if omitted.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional ElevenLabs model ID.
# Default dev value used by backend if omitted.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Gesture classifier mode:
# - rule  -> deterministic landmark rules (recommended default for hackathon demo)
# - model -> centroid model from MODEL_FILE
CLASSIFIER_MODE=rule

# Requested model path variable for team clarity/documentation.
# Note: current backend runtime reads MODEL_FILE, not MODEL_PATH.
MODEL_PATH=app/data/models/gesture_centroid_model.json

# Actual model file variable used by backend/app/services/model_classifier_service.py.
# Keep this aligned with MODEL_PATH when using CLASSIFIER_MODE=model.
MODEL_FILE=app/data/models/gesture_centroid_model.json

# CORS allowed origins for frontend.
# Current backend code uses wildcard defaults; keep this documented for production hardening.
# Example: http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# Whether browsers can send credentials in CORS requests.
# Typical dev default: true
CORS_ALLOW_CREDENTIALS=true

# Allowed HTTP methods for CORS preflight.
# Typical dev default: *
CORS_ALLOW_METHODS=*

# Allowed HTTP headers for CORS preflight.
# Typical dev default: *
CORS_ALLOW_HEADERS=*
